# Mêmes noms que ceux lus par src/database.py. Si tu as déjà un fichier .env, il suffit de vérifier ces lignes.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (ajoute-le à .gitignore).
DB_HOST=localhost      # hors Docker ; dans Docker, docker-compose le remplace par « db »
DB_PORT=5432
DB_NAME=wash_seam_db
DB_USER=postgres
DB_PASS=               # ton mot de passe PostgreSQL
